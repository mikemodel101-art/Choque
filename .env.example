# ——— CHOQUE environment variables ————————————————————————————
# Copy this file to `.env.local` and fill in real values for staging/production.
# Nothing below is required for the local demo (which uses localStorage).

# Canonical URL for the deployed site (for sitemap + OG tags)
NEXT_PUBLIC_SITE_URL=https://choque.app

# ——— Supabase (production build) ———
# Project URL + public anon key for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, never expose to the browser.
# Used by route handlers that must bypass RLS (e.g., email cron).
SUPABASE_SERVICE_ROLE_KEY=

# ——— Email delivery (transactional templates in src/lib/emails.ts) ———
# Sign up at resend.com, verify your domain, and copy the API key.
RESEND_API_KEY=
RESEND_FROM="CHOQUE <hello@choque.app>"

# ——— Cloudflare Turnstile (public-form spam protection) ———
# Free at cloudflare.com/turnstile. Without a key the app falls back to
# honeypot + rate limiting (already active in demo mode).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— Analytics ———
# Vercel Analytics is automatic on Vercel deploys (no key needed).
# The in-app `events` table requires no configuration.

# ——— Demo / seed ———
# Password shared by the five dev role accounts created by
# supabase/seed_dev_users.sql (never run in production).
DEMO_PASSWORD=choque-demo
